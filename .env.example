# Porta externa (única porta exposta ao mundo)
EXTERNAL_PORT=80

# Banco de dados
DB_USER=paulopop
DB_PASSWORD=troque-esta-senha
DB_NAME=academypop

# JWT Secret – OBRIGATÓRIO trocar: openssl rand -hex 32
JWT_SECRET=

# MinIO (storage interno)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_BUCKET=academy-uploads

# Admin padrão (criado no primeiro boot)
ADMIN_EMAIL=admin@paulopop.com.br
ADMIN_PASSWORD=defina-uma-senha-forte
ADMIN_NAME=Paulo Pop

# URL pública do site (sem barra no final). Em produção: https://academypopeduca.com.br
# Usada no canonical/sitemap, no retorno do cartão e na URL do webhook do Mercado Pago.
APP_URL=https://academypopeduca.com.br
NEXT_PUBLIC_APP_URL=https://academypopeduca.com.br

# Origens liberadas no CORS da API (separadas por vírgula). Vazio = só APP_URL.
CORS_ORIGINS=

# Mercado Pago (opcional, para ativar pagamentos reais)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Mercado Pago > Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# WhatsApp do Paulo Pop
NEXT_PUBLIC_WHATSAPP_NUMBER=5561920045537

# ---- v2.1: recuperação de senha e 2FA do painel ----
# SMTP para "Esqueci minha senha" e avisos de segurança por e-mail.
# Ex.: Google Workspace (smtp.gmail.com, 587, senha de app), Brevo (smtp-relay.brevo.com), Hostinger (smtp.hostinger.com, 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Academy Pop <nao-responda@academypopeduca.com.br>"

# Chave que criptografa os segredos do 2FA no banco: openssl rand -hex 32
# ATENÇÃO: não troque depois que algum admin ativar o 2FA (os códigos deixariam de funcionar).
TWOFA_ENCRYPTION_KEY=
